{
  "type": "json_schema",
  "json_schema": {
    "name": "misalignment_validation",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "VALID",
            "INVALID"
          ]
        },
        "invalid_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "invalid_category",
        "note"
      ]
    }
  }
}