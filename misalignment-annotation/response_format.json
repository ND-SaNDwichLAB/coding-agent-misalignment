          "properties": {
            "reasoning": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "S1",
                  "S2",
                  "S3",
                  "S4",
                  "S5",
                  "S6",
                  "S7",
                  "S8"
                ]
              }
            },
            "other_descriptor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reasoning",
            "labels",
            "other_descriptor"
          ]
        },
        "cause": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoning": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "enum": [
                      "C1",
                      "C2",
                      "C3",
                      "C4",
                      "C5",
                      "C6",
                      "C7"
                    ]
                  },
                  "evidence_tier": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "direct",
                      "contextual",
                      "speculative",
                      null
                    ]
                  }
                },
                "required": [
                  "label",
                  "evidence_tier"
                ]
              }
            }
          },
          "required": [
            "reasoning",
            "labels"
          ]
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoning": {
              "type": "string"
            },
            "damage_severity": {
              "type": "string",
              "enum": [
                "DS0",
                "DS1",
                "DS2",
                "DS3",
                "DS4"
              ]
